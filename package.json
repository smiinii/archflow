{
  "name": "archflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests docs README.md vite.config.ts supabase/migrations/*.sql --ignore-unknown"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "@xyflow/react": "^12",
    "idb-keyval": "^6",
    "lucide-react": "latest",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "latest",
    "@testing-library/react": "^16.3.3",
    "@types/node": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "latest",
    "fake-indexeddb": "latest",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "latest",
    "vitest": "latest"
  }
}
